# Paste values like these into Streamlit Cloud's Secrets box.
# Do not commit a real secrets.toml file with production values.

SECRET_KEY = "replace-with-a-long-random-secret"
TW_ENV = "production"

# Optional but recommended for durable data. Neon/Supabase Postgres works here.
# DATABASE_URL = "postgresql://user:password@host/database?sslmode=require"

# Discovery APIs are optional. Leave blank until you have keys.
GOOGLE_API_KEY = ""
GOOGLE_CX = ""
BING_API_KEY = ""
SERPAPI_API_KEY = ""

# Optional email/push secrets.
SMTP_PASSWORD = ""
VAPID_PUBLIC_KEY = ""
VAPID_PRIVATE_KEY = ""
VAPID_SUBJECT = "mailto:admin@example.com"
