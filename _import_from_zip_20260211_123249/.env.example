# Flask
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///tenderwatch.db

# Google/Bing auto-discovery
GOOGLE_API_KEY=
GOOGLE_CX=
BING_API_KEY=

# SMTP (optional fallback if not stored in DB)
SMTP_PASSWORD=

# VAPID (preferred)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional: file paths if keys are on disk
VAPID_PUBLIC_KEY_PATH=vapid_public.pem
VAPID_PRIVATE_KEY_PATH=vapid_private.pem
